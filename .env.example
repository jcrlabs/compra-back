# Server
PORT=8080
ENV=development

# CORS — comma-separated allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=compra
DB_PASSWORD=compra_password
DB_NAME=compra
DB_SSL_MODE=disable

# JWT — REQUIRED, must be >= 32 chars (generate: openssl rand -hex 32)
JWT_SECRET=replace_with_at_least_32_character_secret_key_here
JWT_ACCESS_TTL_HOURS=24

# Scraper
SCRAPER_CRON=0 3 * * *
SCRAPER_USER_AGENT=Mozilla/5.0 (compatible; jcrlabs-bot/1.0)
MERCADONA_POSTAL_CODE=28001

# Admin — required to trigger manual scrapes via POST /api/v1/admin/scrape/:name
# generate: openssl rand -hex 24
ADMIN_SECRET=replace_with_strong_random_secret
